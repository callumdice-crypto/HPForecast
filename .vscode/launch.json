{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "App",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "app/dashboard.py",
        "--server.port",
        "8510"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Backtest and live forecast",
      "type": "debugpy",
      "request": "launch",
      "module": "hpforecast",
      "args": [
        "backtest"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Status",
      "type": "debugpy",
      "request": "launch",
      "module": "hpforecast",
      "args": [
        "status"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
