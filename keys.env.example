# Format is NAME=value on each line, with no spaces around the equals sign and no quote marks.
# keys.env is excluded from version control, but remove it manually before sending this folder to anyone.
OPENAI_API_KEY=
# Only needed if you want Claude to write the look-alike report rather than an OpenAI model.
ANTHROPIC_API_KEY=
# Optional. Override the default model names. Defaults are set in src/hpforecast/config.py.
# LOOKALIKE_WRITER_MODEL=
# LOOKALIKE_JUDGE_MODELS=gpt-5.5
# LOOKALIKE_REASONING_EFFORT=low